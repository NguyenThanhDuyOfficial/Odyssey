{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "@nguyenthanhduyofficial/template",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"description": "Next.js Template for @nguyenthanhduyofficial projects",
	"license": "GPL-3.0-only",
	"repository": {
		"type": "git",
		"url": "https://github.com/NguyenThanhDuyOfficial/Next.js-Template"
	},
	"engines": {
		"node": ">=22.12.0",
		"pnpm": ">=11.0.0"
	},
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"format": "turbo run format",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"test:e2e": "turbo run test:e2e",
		"check": "pnpm format && pnpm lint && pnpm typecheck && pnpm test",
		"prepare": "lefthook install",
		"changeset": "changeset",
		"generate": "turbo run generate"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@changesets/cli": "^3.0.3",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@nguyenthanhduyofficial/typescript-config": "workspace:*",
		"lefthook": "^2.2.2",
		"turbo": "^2.11.10"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.0.0",
			"onFail": "download"
		}
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,json}": "biome check --write --no-errors-on-unmatched"
	}
}
