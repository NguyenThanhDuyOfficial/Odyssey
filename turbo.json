{
	"$schema": "https://turbo.build/schema.json",
	"globalDependencies": [".env", "tsconfig.json"],
	"globalEnv": [
		"NODE_ENV",
		"CI",
		"DATABASE_URL",
		"BETTER_AUTH_SECRET",
		"DISCORD_CLIENT_ID",
		"DISCORD_CLIENT_SECRET"
	],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", ".next/**", "!.next/cache/**", "build/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^lint"],
			"outputs": []
		},

		"format": {
			"dependsOn": ["^format"],
			"outputs": []
		},
		"typecheck": {
			"dependsOn": ["^typecheck"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"test:e2e": {
			"dependsOn": ["^build"],
			"outputs": ["playwright-report/**", "test-results/**"]
		},
		"generate": {},
		"migrate:dev": {}
	}
}
