{
	"$schema": "https://json.schemastore.org/tsconfig",
	"extends": "@nguyenthanhduyofficial/typescript-config/base.json",
	"compilerOptions": {
		"rootDir": ".",
		"outDir": "./dist",
		"noEmit": true,
		"module": "preserve",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"types": ["node"]
	},
	"include": ["src/**/*.ts", "prisma7.config.ts"],
	"exclude": ["node_modules", "dist", "src/generated"]
}
