generator client {
  provider            = "prisma-client"
  output              = "../generated/client"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  /// Better Auth Fields
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  posts         Posts[]
}

model Session {
  /// Better Auth Fields
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Account {
  /// Better Auth Fields
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @db.Timestamptz(3)
  updatedAt             DateTime  @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Verification {
  /// Better Auth Fields
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

model Posts {
  id          String  @id @default(cuid())
  userId      String
  slug        String  @unique
  title       String
  description String?
  content     String
  image       String?
  published   Boolean @default(false)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])
}
